# Platform
CONFIG_ARCH_PARROT=y
# CONFIG_ARCH_RAVELIN is not set

# Audio
# (AW882XX/FS19XX smart-PA are built out-of-tree by audio-kernel, which
#  sets CONFIG_SND_SOC_AW882XX/FS19XX itself in config/waipioauto.conf.)
CONFIG_TARGET_PRODUCT_GARNET=y

# Battery/Fuel Gauge
# CONFIG_MI_WIRELESS is not set

# Fingerprint
CONFIG_FINGERPRINT_FPC_FOD=m
CONFIG_FINGERPRINT_GOODIX_FOD_G3S=m
CONFIG_INPUT_FINGERPRINT=y

# Haptics
CONFIG_INPUT_QCOM_HV_HAPTICS=m

# Infrared and Remote Control
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# MTD
CONFIG_MTD=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_OOPS=m

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Regulator Drivers
# REGMAP_QTI_DEBUGFS_ALLOW_WRITE depends on DEBUG_FS, which debugfs.config
# disables; it only takes effect on debugfs-enabled builds.
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_REGULATOR_QCOM_AMOLED=m
CONFIG_REGULATOR_WL2866D_N16=m

# SKU
CONFIG_BOOTCONFIG_HWC_IS_PRODUCT_SKU=y

# SPSS
# CONFIG_QCOM_SPSS is not set
# CONFIG_RPMSG_QCOM_GLINK_SPSS is not set

# Touchscreen
# (focaltech_3683g/xiaomi_touch are built unconditionally by the external
#  modules repo xiaomi/Kbuild; goodix_brl by touch-drivers via
#  config/gki_parrottouch.conf. No in-kernel Kconfig symbols exist for them.)

# USB Networking
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_AX8817X=m

# LocalVersion
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_LOCALVERSION="-BetterWorld-By-Zen-Itsu"


# Devtmpfs (was enabled in the working 5.10 kernel)
CONFIG_DEVTMPFS=y

# Compiler options
CONFIG_FRAME_WARN=4096
# CONFIG_WERROR is not set
